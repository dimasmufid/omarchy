[Unit]
Description=Omarchy Mobile local companion
Documentation=https://github.com/dimasmufid/omarchy
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-linkd
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=graphical-session.target
